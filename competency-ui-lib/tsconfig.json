{
  "compileOnSave": false,
  
  "angularCompilerOptions": {
    "enableIvy": false
  },
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "resolveJsonModule":true,
    "emitDecoratorMetadata": true,
    "module": "esnext",
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "es2015",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "@aastrika_npmjs/comptency/*": [
        "projects/competency-ui/*"
      ],
      "@aastrika_npmjs/comptency": [
        "projects/competency-ui"
      ]
    }
  }
}