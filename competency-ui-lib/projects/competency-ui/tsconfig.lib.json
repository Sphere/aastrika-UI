{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "target": "es2015",
    "declaration": true,
    "inlineSources": true,
    "declarationMap": false,
    "emitDecoratorMetadata": true,
    "types": [],
    "lib": [
      "dom",
      "es2018"
    ]
  },
  "angularCompilerOptions": {
    "annotateForClosureCompiler": false,
    "skipTemplateCodegen": false, // Should be false to generate metadata
    "strictMetadataEmit": true,    // Set to true for stricter checks (optional)
    "fullTemplateTypeCheck": false,
    "strictInjectionParameters": true,
    "enableResourceInlining": true
  },
  "exclude": [
    "./dist/**/*",
    "src/test.ts",
    "**/*.spec.ts"
  ]
}